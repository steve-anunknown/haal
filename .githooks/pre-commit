#!/usr/bin/env bash
# Reject the commit if any staged Haskell file is not formatted with fourmolu.
# Checks the staged contents (not the working tree), so partial staging is fine.
# Files generated by haal-gen are skipped.
#
# Enable with:  git config core.hooksPath .githooks
# Bypass once:  git commit --no-verify

set -u

if ! command -v fourmolu >/dev/null 2>&1; then
    echo "pre-commit: fourmolu not found on PATH; skipping format check." >&2
    exit 0
fi

unformatted=()

while IFS= read -r -d '' file; do
    case "$file" in
        */.liquid/*) continue ;;
    esac

    if git show ":$file" | head -n 1 | grep -q 'Generated by haal-gen'; then
        continue
    fi

    if ! git show ":$file" | fourmolu -q --mode check --stdin-input-file "$file" >/dev/null 2>&1; then
        unformatted+=("$file")
    fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.hs')

if ((${#unformatted[@]} > 0)); then
    echo "pre-commit: these staged files are not formatted with fourmolu:" >&2
    printf '    %s\n' "${unformatted[@]}" >&2
    echo >&2
    echo "Format them with:" >&2
    printf '    fourmolu -i' >&2
    printf ' %q' "${unformatted[@]}" >&2
    printf '\n' >&2
    echo "then re-stage them (git add)." >&2
    exit 1
fi

exit 0
